// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// USER & AUTHENTICATION
// ============================================
enum UserRole {
  USER
  SUPERUSER
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String   @default("") @map("password_hash")
  name      String?
  phone     String?
  avatar    String?
  role      UserRole @default(USER)
  resetPasswordToken  String?   @map("reset_password_token") // NOVO CAMPO: Token de recuperacao
  resetPasswordExpires DateTime? @map("reset_password_expires") // NOVO CAMPO: Validade
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  accounts          Account[]
  transactions      Transaction[]
  categories        Category[]
  budgets           Budget[]
  notifications     Notification[]
  recurringExpenses RecurringExpense[]
  pluggyItems       PluggyItem[]

  @@map("users")
}

enum DataSource {
  MANUAL
  PLUGGY
}

// ============================================
// ACCOUNTS (conta corrente, poupança, investimento, cartão, carteira)
// ============================================
enum AccountType {
  CHECKING
  SAVINGS
  INVESTMENT
  CREDIT_CARD
  WALLET
  OTHER
}

model Account {
  id              String      @id @default(uuid())
  name            String
  type            AccountType
  institution     String?
  initialBalance  Decimal     @default(0) @map("initial_balance") @db.Decimal(15, 2)
  // Cartão: negativo = valor devido. Investimento: valor contábil (aportes − resgates).
  currentBalance  Decimal     @default(0) @map("current_balance") @db.Decimal(15, 2)
  creditLimit     Decimal?    @map("credit_limit") @db.Decimal(15, 2)
  closingDay      Int?        @map("closing_day")
  dueDate         Int?        @map("due_date")
  color           String      @default("#8B8CFF")
  icon            String      @default("Wallet")
  isActive        Boolean     @default(true) @map("is_active")
  source          DataSource  @default(MANUAL)
  pluggyAccountId String?     @unique @map("pluggy_account_id")
  lastSyncedAt    DateTime?   @map("last_synced_at")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId            String             @map("user_id")
  pluggyItem        PluggyItem?        @relation(fields: [pluggyItemId], references: [id], onDelete: SetNull)
  pluggyItemId      String?            @map("pluggy_item_id")
  transactions      Transaction[]      @relation("TransactionAccount")
  transfersIn       Transaction[]      @relation("TransactionTransferAccount")
  recurringExpenses RecurringExpense[]
  valuations        AccountValuation[]

  @@index([userId])
  @@map("accounts")
}

// Valor de mercado informado manualmente para conta de investimento.
model AccountValuation {
  id        String   @id @default(uuid())
  date      DateTime
  value     Decimal  @db.Decimal(15, 2)
  createdAt DateTime @default(now()) @map("created_at")

  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  accountId String  @map("account_id")

  @@index([accountId, date])
  @@map("account_valuations")
}

// ============================================
// CATEGORIES
// ============================================
enum TransactionType {
  INCOME
  EXPENSE
  PAYMENT // movimento entre contas próprias (fatura, aporte, resgate) — nunca é gasto nem receita
}

model Category {
  id          String          @id @default(uuid())
  name        String
  description String?
  type        TransactionType
  color       String          @default("#8B8CFF")
  icon        String          @default("Tag")
  isDefault   Boolean         @default(false) @map("is_default")
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId            String             @map("user_id")
  transactions      Transaction[]
  budgets           Budget[]
  recurringExpenses RecurringExpense[]

  @@unique([userId, name, type])
  @@map("categories")
}

// ============================================
// TRANSACTIONS
// ============================================
enum TransactionStatus {
  PENDING
  COMPLETED
  CANCELLED
  SCHEDULED
}

// O "por quê" do gasto.
enum SpendingNature {
  ESSENTIAL
  IMPORTANT
  SUPERFLUOUS
}

model Transaction {
  id                  String            @id @default(uuid())
  amount              Decimal           @db.Decimal(15, 2)
  date                DateTime
  description         String
  type                TransactionType
  status              TransactionStatus @default(COMPLETED)
  nature              SpendingNature?
  note                String?
  tags                String[]          @default([])
  installmentNumber   Int?              @map("installment_number")
  totalInstallments   Int?              @map("total_installments")
  parentTransactionId String?           @map("parent_transaction_id")
  invoiceMonth        String?           @map("invoice_month") // YYYY-MM em que a fatura do cartão fecha
  recurringExpenseId  String?           @map("recurring_expense_id")
  occurrenceMonth     String?           @map("occurrence_month") // YYYY-MM do compromisso quitado
  source              DataSource        @default(MANUAL)
  pluggyTransactionId String?           @unique @map("pluggy_transaction_id")
  metadata            Json?
  createdAt           DateTime          @default(now()) @map("created_at")
  updatedAt           DateTime          @updatedAt @map("updated_at")

  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId            String            @map("user_id")
  account           Account           @relation("TransactionAccount", fields: [accountId], references: [id], onDelete: Cascade)
  accountId         String            @map("account_id")
  transferAccount   Account?          @relation("TransactionTransferAccount", fields: [transferAccountId], references: [id], onDelete: Cascade)
  transferAccountId String?           @map("transfer_account_id")
  category          Category?         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  categoryId        String?           @map("category_id")
  attachments       Attachment[]
  parentTransaction Transaction?      @relation("Installments", fields: [parentTransactionId], references: [id], onDelete: Cascade)
  childTransactions Transaction[]     @relation("Installments")
  recurringExpense  RecurringExpense? @relation(fields: [recurringExpenseId], references: [id], onDelete: SetNull)

  @@unique([recurringExpenseId, occurrenceMonth])
  @@index([userId, date])
  @@index([userId, type])
  @@index([accountId])
  @@index([transferAccountId])
  @@index([categoryId])
  @@index([accountId, invoiceMonth])
  @@map("transactions")
}

// ============================================
// ATTACHMENTS
// ============================================
model Attachment {
  id        String   @id @default(uuid())
  url       String
  fileName  String   @map("file_name")
  fileType  String   @map("file_type")
  size      Int
  createdAt DateTime @default(now()) @map("created_at")

  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  transactionId String      @map("transaction_id")

  @@map("attachments")
}

// ============================================
// BUDGETS (limite mensal por categoria, vale para todo mês)
// ============================================
model Budget {
  id         String   @id @default(uuid())
  amount     Decimal  @db.Decimal(15, 2)
  alertAt80  Boolean  @default(true) @map("alert_at_80")
  alertAt100 Boolean  @default(true) @map("alert_at_100")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String   @map("user_id")
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  categoryId String   @map("category_id")

  @@unique([userId, categoryId])
  @@map("budgets")
}

// ============================================
// NOTIFICATIONS
// ============================================
enum NotificationType {
  BUDGET_ALERT
  DUE_DATE
  SYSTEM
  TRANSACTION
}

model Notification {
  id        String           @id @default(uuid())
  title     String
  message   String
  type      NotificationType
  isRead    Boolean          @default(false) @map("is_read")
  data      Json?
  createdAt DateTime         @default(now()) @map("created_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String @map("user_id")

  @@index([userId, isRead])
  @@map("notifications")
}

// ============================================
// RECURRING (compromissos: fixas, assinaturas, carnês, empréstimos, receitas fixas)
// ============================================
enum RecurringType {
  FIXED        // aluguel, condomínio, internet
  SUBSCRIPTION // streaming, apps, academia
  INSTALLMENT  // carnê / parcelamento fora do cartão
  LOAN         // empréstimo, financiamento
  INCOME       // salário, renda fixa
}

enum RecurringStatus {
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

enum RecurringFrequency {
  WEEKLY
  MONTHLY
  YEARLY
}

model RecurringExpense {
  id                String             @id @default(uuid())
  name              String
  description       String?
  type              RecurringType
  status            RecurringStatus    @default(ACTIVE)
  amount            Decimal            @db.Decimal(15, 2)
  frequency         RecurringFrequency @default(MONTHLY)
  dueDay            Int                @map("due_day")
  startDate         DateTime           @map("start_date")
  endDate           DateTime?          @map("end_date")
  // Parcelados: número da parcela que vence no mês de startDate (ex.: cadastrei na 23ª de 48).
  firstInstallment  Int                @default(1) @map("first_installment")
  totalInstallments Int?               @map("total_installments")
  interestRate      Decimal?           @map("interest_rate") @db.Decimal(5, 2)
  color             String             @default("#8B8CFF")
  icon              String             @default("Repeat")
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String        @map("user_id")
  category     Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  categoryId   String?       @map("category_id")
  account      Account?      @relation(fields: [accountId], references: [id], onDelete: SetNull)
  accountId    String?       @map("account_id")
  transactions Transaction[]

  @@index([userId, status])
  @@index([userId, type])
  @@map("recurring_expenses")
}

model PluggyItem {
  id              String    @id @default(uuid())
  pluggyItemId    String    @unique @map("pluggy_item_id")
  connectorId     Int?      @map("connector_id")
  connectorName   String?   @map("connector_name")
  status          String?
  executionStatus String?   @map("execution_status")
  lastSyncedAt    DateTime? @map("last_synced_at")
  lastError       String?   @map("last_error")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at")

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId   String    @map("user_id")
  accounts Account[]

  @@index([userId])
  @@map("pluggy_items")
}

model PluggyWebhookEvent {
  id        String   @id @default(uuid())
  eventId   String   @unique @map("event_id")
  event     String
  createdAt DateTime @default(now()) @map("created_at")

  @@map("pluggy_webhook_events")
}
